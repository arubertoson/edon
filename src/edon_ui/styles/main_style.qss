/* You would typically load icons via a Qt Resource file (.qrc)
   and then reference them like:
   image: url(:/icons/my_icon.png);
   For now, placeholders or simple border/background styles are used.
*/

GraphicsView {
    background-color: #2d2d2d; /* A dark background for the view */
    border: 1px solid #444444; /* A subtle border for the view itself */
} 