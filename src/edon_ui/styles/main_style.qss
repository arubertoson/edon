/* src/edon_ui/styles/main_style.qss */

QWidget {
    font-family: "Segoe UI", Arial, sans-serif; /* Define a base font */
    font-size: 10pt;
    /* Base background and text colors can be defined here or through QPalette */
    /* color: #333; */
    /* background-color: #f0f0f0; */
}

QPushButton {
    background-color: #0078d4; /* Example: Windows blue */
    color: white;
    border: 1px solid #005a9e;
    padding: 6px 12px;
    border-radius: 3px;
    min-height: 20px; /* Ensure buttons have a decent minimum height */
}

QPushButton:hover {
    background-color: #005a9e;
    border-color: #004578;
}

QPushButton:pressed {
    background-color: #004578;
}

QPushButton:disabled {
    background-color: #d3d3d3; /* Light grey */
    color: #a0a0a0;
    border-color: #c0c0c0;
}

QLineEdit, QTextEdit, QPlainTextEdit {
    padding: 5px;
    border: 1px solid #ababab;
    border-radius: 3px;
    background-color: #ffffff;
    color: #202020;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #0078d4; /* Highlight focus */
}

QLineEdit:read-only, QTextEdit:read-only, QPlainTextEdit:read-only {
    background-color: #e6e6e6;
    color: #505050;
}


QLabel {
    padding: 2px;
}

QCheckBox, QRadioButton {
    spacing: 5px; /* Spacing between indicator and text */
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox::indicator:unchecked, QRadioButton::indicator:unchecked {
    /* Add images or specific styles for unchecked state */
    /* image: url(:/styles/icons/checkbox_unchecked.png); */
    border: 1px solid #767676;
    background-color: #f0f0f0;
    border-radius: 3px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    /* Add images or specific styles for checked state */
    /* image: url(:/styles/icons/checkbox_checked.png); */
    background-color: #0078d4;
    border: 1px solid #005a9e;
    border-radius: 3px;
    /* You might want an actual checkmark image here */
}

QGroupBox {
    border: 1px solid #c0c0c0;
    border-radius: 4px;
    margin-top: 10px; /* Space for the title */
    padding: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px 0 5px;
    left: 10px; /* Position title slightly inset from the border */
    background-color: #f0f0f0; /* Match potential window background */
    color: #333;
}

